# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Токен чат-бота, выдан организаторами хакатона.
MAX_BOT_TOKEN=<токен>

# Адрес мини-приложения для кнопки "Открыть карточку дома" в боте.
MAX_WEBAPP_URL=https://vyacheslavbelg.github.io/Project-Pennsylvania-/

# Пароль базы данных. Для локального запуска подойдёт любой.
POSTGRES_PASSWORD=domovoy

# Источники, которым разрешены запросы к API мини-приложения.
WEBAPP_ORIGINS=https://vyacheslavbelg.github.io,http://localhost:8081

# Адрес бэкенда, который попадёт в сборку мини-приложения.
# Пустое значение — приложение соберётся и покажет состояние "сервис не подключён".
VITE_API_BASE_URL=http://localhost:8080
